<?xml version="1.0" encoding="utf-8"?>
<!-- Held on PDFx's icon: scan, the last file, search. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="last"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_last"
        android:shortcutShortLabel="@string/shortcut_last"
        android:shortcutLongLabel="@string/shortcut_last_long">
        <intent
            android:action="com.fadysaeed.pdfx.action.LAST"
            android:targetPackage="com.fadysaeed.pdfx"
            android:targetClass="com.fadysaeed.pdfx.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="com.fadysaeed.pdfx.action.SCAN"
            android:targetPackage="com.fadysaeed.pdfx"
            android:targetClass="com.fadysaeed.pdfx.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.fadysaeed.pdfx.action.SEARCH"
            android:targetPackage="com.fadysaeed.pdfx"
            android:targetClass="com.fadysaeed.pdfx.MainActivity" />
    </shortcut>
</shortcuts>
